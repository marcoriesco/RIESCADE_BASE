<?xml version="1.0" encoding="UTF-8"?>
<theme>
    <formatVersion>7</formatVersion>

    <view name="splash">

        <splash name="splash">
            <backgroundColor>333333FF</backgroundColor>
        </splash>

        <image name="background">
            <pos>0.5 0.5</pos>
            <origin>0.5 0.5</origin>
            <minSize>1 1</minSize>
            <roundCorners>0</roundCorners>
            <linearSmooth>false</linearSmooth>
            <color>FFFFFFFF</color>
        </image>

        <screenshader name="blur" extra="static">
            <path>:/shaders/blur.glsl</path>
            <pos>0 0</pos>
            <size>1 1</size>
            <blur>6</blur>
            <visibility>true</visibility>
            <zIndex>6</zIndex>
        </screenshader>

        <image name="overlay" extra="static">
            <origin>0 0</origin>
            <pos>0 0</pos>
            <size>1 1</size>
            <path>./resources/_parts/overlay-gamelist-hard.png</path>
            <zIndex>7</zIndex>
        </image>

        <image name="game-logo" extra="static">
            <origin>0.5 0.5</origin>
            <pos>0.5 0.5</pos>
            <maxSize>0.300 0.280</maxSize>
            <path>{game:marquee}</path>
            <zIndex>30</zIndex>
        </image>

        <text name="label">
            <origin>0 0</origin>
            <pos>0 0.77</pos>
            <size>1 0.10</size>
            <fontPath>./resources/fonts/InterTight-SemiBold.ttf</fontPath>
            <fontSize>0.044</fontSize>
            <color>FFFFFFFF</color>

            <glowColor>000000</glowColor>
            <glowSize>1</glowSize>
            <glowOffset>1.5</glowOffset>
            <alignment>center</alignment>
            <extraTextColor>FFFFFF80</extraTextColor>
            <zIndex>32</zIndex>
        </text>

        <text name="loading" extra="static">
            <origin>0 0</origin>
            <pos>0 0.86</pos>
            <size>1 0.03</size>
            <fontPath>./resources/fonts/InterTight-Regular.ttf</fontPath>
            <fontSize>0.024</fontSize>
            <color>FFFFFFFF</color>

            <glowColor>000000</glowColor>
            <glowSize>1</glowSize>
            <glowOffset>1</glowOffset>
            <alignment>center</alignment>

            <text>LOADING...</text>
            <text lang="pt">CARREGANDO...</text>

            <zIndex>32</zIndex>
        </text>

        <image name="loading-icon" extra="static">
            <origin>1 0</origin>
            <pos>0.444 0.86</pos>
            <maxSize>0.03 0.03</maxSize>
            <alignment>left</alignment>
            <path ifSubset="colors:9f0043">./resources/_parts/loadings/loading-9f0043.png</path>
            <path ifSubset="colors:ffffff">./resources/_parts/loadings/loading-ffffff.png</path>
            <path ifSubset="colors:3377ff">./resources/_parts/loadings/loading-3377ff.png</path>
            <path ifSubset="colors:13eafd">./resources/_parts/loadings/loading-13eafd.png</path>
            <path ifSubset="colors:fb2246">./resources/_parts/loadings/loading-fb2246.png</path>
            <path ifSubset="colors:cccccc">./resources/_parts/loadings/loading-cccccc.png</path>
            <path ifSubset="colors:00ffbf">./resources/_parts/loadings/loading-00ffbf.png</path>
            <path ifSubset="colors:9133c7">./resources/_parts/loadings/loading-9133c7.png</path>
            <path ifSubset="colors:ffc233">./resources/_parts/loadings/loading-ffc233.png</path>
            <path>./resources/_parts/loadings/loading.png</path>
            <zIndex>32</zIndex>
        </image>
    </text>

</view>

</theme>