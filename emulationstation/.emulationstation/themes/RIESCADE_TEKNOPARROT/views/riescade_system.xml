<?xml version="1.0" encoding="UTF-8"?>

<theme>

    <formatVersion>7</formatVersion>

    <view name="system">

        <carousel name="systemcarousel">
            <pos>0 0</pos>
            <size>1 1</size>
            <type>horizontal</type>
            <logoAlignment>center</logoAlignment>
            <logoSize>0.09 0.08</logoSize>
            <logoScale>1.7</logoScale>
            <minLogoOpacity>0.5</minLogoOpacity>
            <maxLogoCount>5</maxLogoCount>
            <color>00000000</color>
            <colorEnd>00000000</colorEnd>
            <systemInfoDelay>700</systemInfoDelay>
            <systemInfoCountOnly>false</systemInfoCountOnly>
            <transitionSpeed>600</transitionSpeed>
            <linearSmooth>false</linearSmooth>
            <defaultTransition>instant</defaultTransition>
            <zIndex>20</zIndex>
        </carousel>

        <text name="logoText">
            <fontPath>./resources/fonts/InterTight-SemiBold.ttf</fontPath>
            <fontSize>0.026</fontSize>
            <color>FFFFFFFF</color>
        </text>

        <image name="logo">
            <path>./resources/logos/${system.theme}.png</path>
            <!-- check if lang resources exist -->
            <path>./resources/logos/${system.theme}-${lang}.png</path>
            <linearSmooth>true</linearSmooth>
            <saturation>1</saturation>

            <storyboard event="activate">
                <animation property="opacity" to="0" begin="0" duration="100" mode="easeIn"/>
                <animation property="offsetX" to="0.005" begin="0" duration="150" mode="easeIn"/>
                <animation property="scale" to="0" begin="0" duration="150" mode="easeIn"/>
            </storyboard>
            <storyboard event="deactivate">
                <animation property="opacity" from="0" to="0.5" begin="100" duration="100" mode="easeIn"/>
                <animation property="offsetX" to="0" begin="0" duration="150" mode="easeIn"/>
                <animation property="scale" from="0" to="0.5" begin="0" duration="150" mode="easeIn"/>
            </storyboard>
            <storyboard event="scroll">
                <animation property="opacity" to="0.5" begin="0" duration="0" mode="easeOut"/>
                <animation property="offsetX" to="0" begin="0" duration="150" mode="easeIn"/>
                <animation property="scale" to="0.5" begin="0" duration="0" mode="linear"/>
            </storyboard>
        </image>

        <!-- custom collections logos -->
        <image name="logo" if="{system.collection}">
            <path>./resources/logos/collections/${system.theme}.png</path>
        </image>

        <!-- Shadow Effect -->
        <image name="logoEffectShadow" extra="true">
            <origin>0.5 0.5</origin>
            <pos>0.497 0.5</pos>
            <maxSize>0.2 0.14</maxSize>
            <color>000000</color>
            <path>./resources/logos/${system.theme}.png</path>
            <path>./resources/logos/${system.theme}-${lang}.png</path>
            <zIndex>21</zIndex>

            <storyboard>
                <animation property="scale" from="0.7" to="1" autoreverse="false" duration="150" mode="easyOut"/>
            </storyboard>
        </image>
        <image name="logoEffect" extra="true">
            <origin>0.5 0.5</origin>
            <pos>0.497 0.5</pos>
            <maxSize>0.2 0.14</maxSize>
            <linearSmooth>true</linearSmooth>
            <path>./resources/logos/${system.theme}.png</path>
            <path>./resources/logos/${system.theme}-${lang}.png</path>

            <color if="${system.name} == 'retrobat'">${subset.colors}</color>
            <color if="${system.name} == 'collections'">${subset.colors}</color>
            <color if="${system.name} == 'favorites'">${subset.colors}</color>
            <color if="${system.name} == 'library'">${subset.colors}</color>
            <color if="${system.name} == 'neverplayed'">${subset.colors}</color>
            <color if="${system.name} == 'recent'">${subset.colors}</color>
            <color if="${system.name} == 'screenshots'">${subset.colors}</color>
            <color if="${system.name} == '2players'">${subset.colors}</color>
            <color if="${system.name} == '4players'">${subset.colors}</color>
            <color if="${system.name} == 'all'">${subset.colors}</color>
            <color if="${system.name} == 'wheel'">${subset.colors}</color>
            <color if="${system.name} == 'vertical'">${subset.colors}</color>
            <color if="${system.name} == 'trackball'">${subset.colors}</color>
            <color if="${system.name} == 'spinner'">${subset.colors}</color>
            <color if="${system.name} == 'retroachievements'">${subset.colors}</color>
            <color if="${system.name} == 'lightgun'">${subset.colors}</color>
            <color if="${system.name} == 'magazine'">${subset.colors}</color>

            <zIndex>21</zIndex>

            <storyboard>
                <animation property="scale" from="0.7" to="1" begin="" autoreverse="false" duration="150" mode="easyOut"/>
            </storyboard>
        </image>

        <!-- System Fanart -->
        <image name="fanart" extra="static">
            <origin>0 0</origin>
            <pos>0 0</pos>
            <size>1 1</size>
            <path>./resources/_parts/default.png</path>
            <path>./resources/arts/${system.theme}.jpg</path>
            <linearSmooth>true</linearSmooth>
            <zIndex>10</zIndex>
        </image>

        <image name="overlay" extra="static">
            <origin>0 0</origin>
            <pos>0 0</pos>
            <size>1 1</size>
            <path>./resources/_parts/overlay-system.png</path>
            <zIndex>15</zIndex>
        </image>

        <!-- Background Animations -->
        <image name="sky1" extra="true">
            <path>./resources/sky1.png</path>
            <origin>0 0.5</origin>
            <pos>-0.3646 0.5</pos>
            <size>1.3906 0.7222</size>
            <opacity>0.4</opacity>
            <zIndex>18</zIndex>
            <storyboard repeat="forever">
                <animation property="x" from="-0.3646" to="-0.1042" duration="10000" mode="linear" autoreverse="true"/>
            </storyboard>
            <storyboard event="activate">
                <animation property="opacity" from="0" to="0.4" duration="250" mode="easeIn"/>
            </storyboard>
            <storyboard event="deactivate">
                <animation property="opacity" to="0" duration="250" mode="easeOut"/>
            </storyboard>
        </image>

        <image name="sky2" extra="true">
            <path>./resources/sky2.png</path>
            <origin>0 0.5</origin>
            <pos>-0.8854 0.5</pos>
            <size>2.0052 0.6296</size>
            <opacity>0.7</opacity>
            <zIndex>17</zIndex>
            <storyboard repeat="forever">
                <animation property="x" from="-0.8854" to="-0.1250" duration="20000" mode="linear" autoreverse="true"/>
            </storyboard>
            <storyboard event="activate">
                <animation property="opacity" from="0" to="0.7" duration="250" mode="easeIn"/>
            </storyboard>
            <storyboard event="deactivate">
                <animation property="opacity" to="0" duration="250" mode="easeOut"/>
            </storyboard>
        </image>

        <image name="overlay_converted" extra="true">
            <path>./resources/Overlay.png</path>
            <pos>0 0</pos>
            <size>1 1</size>
            <zIndex>18</zIndex>
        </image>

        <image name="promo_overlay" extra="true">
            <path>./resources/PromoOverlay2.png</path>
            <origin>0.5 0.5</origin>
            <pos>0.5 0.5</pos>
            <size>1 1</size>
            <opacity>1</opacity>
            <zIndex>18</zIndex>
            <storyboard event="activate">
                <animation property="opacity" from="0" to="1" duration="250" mode="easeInQuadratic"/>
                <animation property="scale" from="1.05" to="1" duration="250" mode="easeInQuadratic"/>
            </storyboard>
            <storyboard event="deactivate">
                <animation property="opacity" to="0" duration="250" mode="easeInQuadratic"/>
                <animation property="scale" to="1.05" duration="250" mode="easeInQuadratic"/>
            </storyboard>
        </image>

        <image name="hardware_selected" extra="static">
            <origin>0 0</origin>
            <pos>0 0</pos>
            <size>0.1953 1</size>
            <path if="${system.name} == 'all'">./resources/all.png</path>
            <path if="{system.hardwareType} == 'arcade'">./resources/1_arcades.png</path>
            <path if="{system.hardwareType} == 'computer'">./resources/5_computer.png</path>
            <path if="{system.hardwareType} == 'console'">./resources/3_retroConsoles.png</path>
            <path if="{system.hardwareType} == 'portable'">./resources/4_handhelds.png</path>
            <path if="{system.hardwareType} == 'extension'">./resources/1_extensions.png</path>
            <path if="{system.hardwareType} == 'port'">./resources/1_ports.png</path>
            <path if="{system.hardwareType} == 'pinball'">./resources/1_pinball.png</path>
            <zIndex>99</zIndex>
        </image>

        <!-- Número de Games -->
        <text name="systemInfo">
            <zIndex>0</zIndex>
        </text>

        <text name="game_total" extra="true">
            <origin>0 0</origin>
            <pos>0 0.952</pos>
            <size>0.985 0.03</size>

            <!-- Default -->
            <text>{binding:total} GAMES</text>
            <text if="${system.name} == 'retrobat'"></text>
            <text if="${system.name} == 'collections'">{system:subSystems}</text>
            <text if="${system.name} == 'favorites'">{system:favorites}</text>
            <text if="${system.name} == 'library'"></text>
            <text if="${system.name} == 'screenshots'"></text>
            <text if="${system.name} == 'magazine'">{system:total}</text>
            <text if="${system.name} == 'all'">{system:total}</text>

            <fontPath>./resources/fonts/Roboto-Bold.ttf</fontPath>
            <fontSize>0.024</fontSize>
            <color>FFFFFFFF</color>
            <glowColor>000000</glowColor>
            <glowSize>1</glowSize>
            <glowOffset>1</glowOffset>
            <extraTextColor>${subset.colors}</extraTextColor>
            <alignment>right</alignment>
            <verticalAlignment>center</verticalAlignment>

            <zIndex>99</zIndex>
        </text>

    </view>

</theme>